{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "metadata": {
        "name": "library-secrets",
        "namespace": "mhasani-personal"
      },
      "type": "Opaque",
      "stringData": {
        "DB_PASSWORD": "REPLACE_ME_DB_APP_PASSWORD",
        "DB_MIGRATION_PASSWORD": "REPLACE_ME_DB_OWNER_PASSWORD",
        "OIDC_CLIENT_SECRET": "REPLACE_ME_OIDC_CLIENT_SECRET",
        "SESSION_COOKIE_KEY": "REPLACE_ME_BASE64_OF_32_RANDOM_BYTES"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "library-files",
        "namespace": "mhasani-personal"
      },
      "spec": {
        "accessModes": ["ReadWriteOnce"],
        "resources": {
          "requests": { "storage": "5Gi" }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "library",
        "namespace": "mhasani-personal",
        "labels": { "app": "library" }
      },
      "spec": {
        "replicas": 1,
        "selector": { "matchLabels": { "app": "library" } },
        "template": {
          "metadata": { "labels": { "app": "library" } },
          "spec": {
            "containers": [
              {
                "name": "library",
                "image": "registry.hamdocker.ir/mhasani/library:main",
                "imagePullPolicy": "Always",
                "ports": [{ "containerPort": 8080 }],
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "capabilities": { "drop": ["ALL"] }
                },
                "env": [
                  { "name": "DB_HOST", "value": "REPLACE_ME_POSTGRES_SERVICE_NAME" },
                  { "name": "DB_PORT", "value": "5432" },
                  { "name": "DB_NAME", "value": "library_db" },
                  { "name": "DB_USER", "value": "library_app" },
                  { "name": "DB_MIGRATION_USER", "value": "library_owner" },
                  {
                    "name": "DB_MIGRATION_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": { "name": "library-secrets", "key": "DB_MIGRATION_PASSWORD" }
                    }
                  },
                  {
                    "name": "DB_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": { "name": "library-secrets", "key": "DB_PASSWORD" }
                    }
                  },
                  { "name": "APP_PUBLIC_URL", "value": "REPLACE_ME_PUBLIC_URL" },
                  { "name": "OIDC_ISSUER_URI", "value": "REPLACE_ME_PUBLIC_URL/auth/realms/library" },
                  { "name": "OIDC_INTERNAL_ISSUER_URI", "value": "REPLACE_ME_KEYCLOAK_SERVICE_URL/auth/realms/library" },
                  {
                    "name": "OIDC_CLIENT_SECRET",
                    "valueFrom": {
                      "secretKeyRef": { "name": "library-secrets", "key": "OIDC_CLIENT_SECRET" }
                    }
                  },
                  {
                    "name": "SESSION_COOKIE_KEY",
                    "valueFrom": {
                      "secretKeyRef": { "name": "library-secrets", "key": "SESSION_COOKIE_KEY" }
                    }
                  },
                  { "name": "STORAGE_PATH", "value": "/data/library-files" }
                ],
                "volumeMounts": [
                  { "name": "library-files", "mountPath": "/data/library-files" }
                ],
                "readinessProbe": {
                  "httpGet": { "path": "/api/v1/stats", "port": 8080 },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 8
                },
                "livenessProbe": {
                  "httpGet": { "path": "/api/v1/stats", "port": 8080 },
                  "initialDelaySeconds": 45,
                  "periodSeconds": 20,
                  "timeoutSeconds": 5,
                  "failureThreshold": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "library-files",
                "persistentVolumeClaim": { "claimName": "library-files" }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "library",
        "namespace": "mhasani-personal"
      },
      "spec": {
        "selector": { "app": "library" },
        "ports": [{ "port": 8080, "targetPort": 8080 }],
        "type": "ClusterIP"
      }
    }
  ]
}
