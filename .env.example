# Do not copy this file by hand: run ./scripts/generate-env.sh, which writes .env with
# strong random secrets. This file only documents the variables. .env is gitignored.

# ── Database ────────────────────────────────────────────────
DB_NAME=library_db
DB_USER=                 # schema owner (migrations only)
DB_PASSWORD=
DB_APP_USER=             # runtime role with DML-only privileges
DB_APP_PASSWORD=

KC_DB_USER=keycloak      # Keycloak's own database account
KC_DB_PASSWORD=

# ── Identity provider (Keycloak) ────────────────────────────
APP_PUBLIC_URL=          # exactly what users type, e.g. https://library.local:3000
OIDC_CLIENT_SECRET=
KC_BOOTSTRAP_ADMIN_USERNAME=   # temporary Keycloak admin (first start only)
KC_BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_EMAIL=   # becomes SUPER_ADMIN at first login
ORGANIZATION_NAME=

# ── Session cookie encryption ───────────────────────────────
SESSION_COOKIE_KEY=      # base64 of 32 random bytes

# ── Network / TLS ───────────────────────────────────────────
FRONTEND_PORT=3000       # HTTPS port published by nginx
TLS_COMMON_NAME=library.local
TZ=Asia/Tehran

# ── Optional ────────────────────────────────────────────────
# LOG_LEVEL_ROOT=INFO     LOG_LEVEL_APP=INFO     LOG_LEVEL_SECURITY=INFO
# SWAGGER_ENABLED=false
# KEYCLOAK_ADMIN_PORT=8180      Keycloak admin console, bound to 127.0.0.1 only
# SESSION_BIND_CLIENT_IP=true   end a session if its client IP changes
