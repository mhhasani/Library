FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 1001 appgroup && \
    useradd --system --uid 1001 --gid appgroup appuser
COPY target/library-management-system-1.0.0.jar app.jar
# storage path owned by appuser so a fresh named volume here is writable (avoids upload AccessDenied)
RUN mkdir -p /data/library-files /var/log/library \
    && chown -R appuser:appgroup /data /var/log/library app.jar
USER appuser
EXPOSE 8080
ENTRYPOINT ["java", "-XX:+ExitOnOutOfMemoryError", "-Djava.awt.headless=true", "-jar", "app.jar"]
