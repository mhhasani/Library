# Rendered at container start by the official image's envsubst step; only variables that
# exist in the container environment (BACKEND_HOST, BACKEND_PORT) are substituted, so
# nginx runtime variables ($host, $remote_addr, ...) are left untouched.

# ── Load-threshold management ──────────────────────────────────────────────
limit_req_zone  $binary_remote_addr zone=api_rate:10m  rate=20r/s;
limit_req_zone  $binary_remote_addr zone=auth_rate:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=per_ip:10m;
limit_req_status  429;
limit_conn_status 429;

# Port the client actually used (the published host port, e.g. 3000), so the backend sees
# the same origin as the browser — required for same-origin checks and redirect URLs.
map $http_host $client_port {
    "~:(?<p>\d+)$" $p;
    default         443;
}

log_format main_ext '$remote_addr - $remote_user [$time_iso8601] "$request" $status '
                    '$body_bytes_sent "$http_referer" "$http_user_agent" '
                    'rt=$request_time urt=$upstream_response_time req_id=$request_id';

server {
    # HTTPS only. A plain-HTTP request to this port gets nginx error 497, which is turned
    # into a redirect to the same host:port over HTTPS (works for any published port).
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;
    error_page 497 =301 https://$http_host$request_uri;

    server_tokens off;
    autoindex off;
    root  /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/access.log main_ext;
    error_log  /var/log/nginx/error.log warn;

    client_max_body_size  110m;
    client_body_timeout   30s;
    client_header_timeout 15s;
    send_timeout          30s;
    keepalive_timeout     30s;
    limit_conn per_ip 50;

    include /etc/nginx/snippets/security-headers.conf;

    # Never serve hidden files (.git, .env, ...)
    location ~ /\. {
        deny all;
    }

    location /api/ {
        limit_req zone=api_rate burst=40 nodelay;
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 120s;
        proxy_hide_header X-Powered-By;
    }

    location /api/v1/auth/ {
        limit_req zone=auth_rate burst=10 nodelay;
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # Hashed build assets are immutable — cache them aggressively
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Never cache the HTML entrypoint so users always get the latest bundle
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location / {
        try_files $uri /index.html;
    }
}
