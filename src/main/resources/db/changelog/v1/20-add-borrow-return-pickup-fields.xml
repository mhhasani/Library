<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="20" author="system">
        <comment>Return-pickup workflow: recipient requests return, librarian schedules courier pickup.</comment>
        <addColumn tableName="borrows">
            <column name="return_requested_at" type="timestamp"/>
            <column name="return_address" type="text"/>
            <column name="return_extension" type="varchar(50)"/>
            <column name="return_preferred_date" type="timestamp"/>
            <column name="return_courier_name" type="varchar(255)"/>
            <column name="return_planned_date" type="timestamp"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
