<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="4" author="system">
        <comment>Create library_memberships table</comment>

        <createTable tableName="library_memberships">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_library_memberships"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_library_memberships_user_id" references="users(id)"/>
            </column>
            <column name="library_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_library_memberships_library_id" references="libraries(id)"/>
            </column>
            <column name="role" type="library_membership_role" defaultValue="MEMBER">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="membership_status" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="approved_by" type="BIGINT">
                <constraints foreignKeyName="fk_library_memberships_approved_by" references="users(id)"/>
            </column>
            <column name="rejection_reason" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="library_memberships" columnNames="user_id,library_id" constraintName="uk_user_library"/>

        <createIndex indexName="idx_user_id" tableName="library_memberships">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_library_id" tableName="library_memberships">
            <column name="library_id"/>
        </createIndex>
        <createIndex indexName="idx_status" tableName="library_memberships">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
