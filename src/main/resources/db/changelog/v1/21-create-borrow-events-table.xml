<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="21" author="system">
        <comment>Per-borrow audit timeline (who did what and when).</comment>
        <createTable tableName="borrow_events">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="borrow_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_borrow_event_borrow"
                             references="borrows(id)" deleteCascade="true"/>
            </column>
            <column name="title" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="detail" type="text"/>
            <column name="actor_name" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="borrow_events" indexName="idx_borrow_event_borrow">
            <column name="borrow_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
