<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="5" author="system">
        <comment>Create books table</comment>

        <createTable tableName="books">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_books"/>
            </column>
            <column name="library_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="author" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="publisher" type="VARCHAR(255)"/>
            <column name="publication_year" type="INT"/>
            <column name="description" type="TEXT"/>
            <column name="cover_image_url" type="VARCHAR(500)"/>
            <column name="auto_digital_borrow_enabled" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="books"
                baseColumnNames="library_id"
                constraintName="fk_books_library_id"
                referencedTableName="libraries"
                referencedColumnNames="id"/>

        <createIndex indexName="idx_title" tableName="books">
            <column name="title"/>
        </createIndex>
        <createIndex indexName="idx_author" tableName="books">
            <column name="author"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
