<?xml version="1.0" encoding="UTF-8"?>
<!--
  Centralized logging configuration.

  Levels: all six levels are supported and individually switchable per deployment
  (TRACE, DEBUG, INFO, WARN, ERROR, and FATAL — logback has no FATAL level, so fatal
  events are written at ERROR with the "FATAL" marker, see com.library.logging.LogMarkers).
  Levels are set from the environment through application.yml (LOG_LEVEL_ROOT,
  LOG_LEVEL_APP, LOG_LEVEL_SECURITY).

  Appenders:
    - CONSOLE       : container stdout (collected by docker)
    - APP_FILE      : rolling application log
    - AUDIT_FILE    : rolling security/audit log (logger "AUDIT"), kept longer
  Every line carries the request id, user and client IP from the MDC (RequestLoggingFilter).
-->
<configuration>
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="/var/log/library"/>

    <property name="PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %marker [%thread] [req=%X{requestId:-} user=%X{userId:-} ip=%X{clientIp:-}] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>365</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Security audit trail: always INFO and above, never mixed into the app log -->
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>
</configuration>
