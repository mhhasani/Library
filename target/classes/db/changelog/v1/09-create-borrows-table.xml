<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="9" author="system">
        <comment>Create borrows table</comment>

        <createTable tableName="borrows">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_borrows"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_borrows_user_id" references="users(id)"/>
            </column>
            <column name="library_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_borrows_library_id" references="libraries(id)"/>
            </column>
            <column name="book_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_borrows_book_id" references="books(id)"/>
            </column>
            <column name="borrow_type" type="borrow_type">
                <constraints nullable="false"/>
            </column>
            <column name="book_copy_id" type="BIGINT">
                <constraints foreignKeyName="fk_borrows_book_copy_id" references="book_copies(id)"/>
            </column>
            <column name="digital_book_id" type="BIGINT">
                <constraints foreignKeyName="fk_borrows_digital_book_id" references="digital_books(id)"/>
            </column>
            <column name="status" type="borrow_status" defaultValue="REQUESTED">
                <constraints nullable="false"/>
            </column>
            <column name="approved_by" type="BIGINT">
                <constraints foreignKeyName="fk_borrows_approved_by" references="users(id)"/>
            </column>
            <column name="rejected_by" type="BIGINT">
                <constraints foreignKeyName="fk_borrows_rejected_by" references="users(id)"/>
            </column>
            <column name="rejection_reason" type="TEXT"/>
            <column name="borrow_date" type="TIMESTAMP"/>
            <column name="due_date" type="TIMESTAMP"/>
            <column name="return_date" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_borrows_status" tableName="borrows">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_due_date" tableName="borrows">
            <column name="due_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
